    {
      "id": "odh-select",
      "x": 55,
      "y": 925,
      "w": 650,
      "h": 108,
      "title": "G8 · Select manifests + immutable image digests",
      "lines": [
        "Daily 06:00 UTC / manual manifest-update PR",
        "Merge updated SHA / digest pins; eligibility policy ? Q4"
      ],
      "kind": "gate",
      "detail": "ODH Update Manifest SHAs runs make update-refs-shas and resolves image digests when updates are needed, opening a PR. Failed component fetches add do-not-merge and fail the workflow. manifests-config.yaml pins TrustyAI module manifests from ODH main and keeps explicit image digests. Build Config separately lists selected relatedImages. These configurations can lag independently; atomicity was not established.",
      "sources": [
        "manifest-update",
        "manifest-pins",
        "odh-digests"
      ],
      "questions": [
        "Q3",
        "Q4"
      ]
