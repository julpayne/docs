{
  "title": "From upstream PR to ODH images and a staged RHOAI installer",
  "asOf": "2026-10-19",
  "scope": "Current ODH / next RHOAI development path. rhoai-3.6 is the inspected release-branch example; EA branch gates differ. Configuration evidence, not an audit of live Konflux resources or successful build runs.",
  "nodes": [
    {
      "id": "eval-pr",
      "x": 55,
      "y": 125,
      "w": 650,
      "h": 82,
      "title": "EvalHub PR → upstream main",
      "lines": [
        "eval-hub/eval-hub"
      ],
      "kind": "source",
      "detail": "Start with a PR in the canonical EvalHub repo. All binaries are built into the same container; the API, init, sidecar and MCP binaries do not represent four independent image promotion chains.",
