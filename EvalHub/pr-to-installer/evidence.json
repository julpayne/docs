    {
      "id": "eval-promote",
      "x": 55,
      "y": 535,
      "w": 650,
      "h": 102,
      "title": "G5 · ODH main → stable sync PR",
      "lines": [
        "Push to main / manual creates sync PR",
        "Gate: merge PR; resolve conflicts and destination requirements."
      ],
      "kind": "gate",
      "detail": "Sync main to stable is a PR workflow with fail-on-conflict=true. It must merge before the stable push image build runs. Required checks on stable were not established.",
      "sources": [
        "eval-stable"
      ],
      "questions": []
