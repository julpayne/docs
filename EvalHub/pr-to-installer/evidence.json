    {
      "id": "operator-promote",
      "x": 815,
      "y": 535,
      "w": 650,
      "h": 102,
      "title": "G6 · ODH main → incubation → stable PRs",
      "lines": [
        "main push opens incubation PR; incubation push opens stable PR",
        "Module image has a separate main build (Q3)."
      ],
      "kind": "gate",
      "detail": "Two workflows open promotion PRs. Creating these PRs is not evidence they have merged. The module operator build currently targets main, while the workload operator stable definition targets stable.",
      "sources": [
