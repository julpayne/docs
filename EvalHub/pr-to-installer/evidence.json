    {
      "id": "odh-bundle",
      "x": 55,
      "y": 1225,
      "w": 650,
      "h": 126,
      "title": "ODH development bundle / catalog path",
      "lines": [
        "ODH-Build-Config pins relatedImages; bundle build",
        "Operator stable → bundle sync every 2h / manual",
        "Bundle → catalog nudge; processor / policy details ? Q4–Q5"
      ],
      "kind": "build",
      "detail": "The ODH bundle CI PipelineRun publishes opendatahub-operator-bundle:odh-stable and nudges catalog/catalog-patch.yaml. A bundle-patch-only change is excluded from the direct bundle build and needs processed output. Bundle Sync CI generates bundle content from opendatahub-operator stable. The complete active ODH processor/catalog policy was not audited; this is contextual to the requested ODH image endpoint.",
      "sources": [
        "odh-bundle",
        "odh-bundle-sync",
        "odh-digests"
      ],
      "questions": [
        "Q4",
        "Q5"
      ]
