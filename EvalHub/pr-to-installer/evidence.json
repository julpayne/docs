    {
      "id": "rh-nudge",
      "x": 815,
      "y": 1250,
      "w": 650,
      "h": 110,
      "title": "G10 · Component digest nudge PR → installer",
      "lines": [
        "rhods-operator build/operator-nudging.yaml",
        "Bot + one-file + title/version feasibility → auto-merge path"
      ],
      "kind": "gate",
      "detail": "The installer insta-merge workflow restricts handling to konflux-internal-p02[bot], permitted title/version pattern and exactly the nudging file. It invokes shared insta-merge logic; this file alone does not establish additional CI or policy verdicts required before the nudge is emitted. The Operator Processor runs on an eligible bot push or manual dispatch.",
      "sources": [
        "operator-nudge",
        "operator-process"
      ],
      "questions": [
        "Q4",
        "Q5"
      ]
    },
    {
      "id": "rh-installer",
      "x": 815,
      "y": 1400,
      "w": 650,
      "h": 115,
      "title": "G11 · Assemble + build RHOAI installer operator",
      "lines": [
        "Processor: digests → operands map + source manifest metadata",
        "Prefetch matching manifests; publish odh-rhel9-operator",
        "Nightly/manual refresh is a separate route."
      ],
      "kind": "build",
      "detail": "The processor combines Build Config relatedImages with nudged digests, resolves image git.url/git.commit labels for manifest entries, and commits generated operands and prefetched content. A qualifying release-branch push builds the installer and nudges RHOAI Build Config bundle/bundle-patch.yaml. The nightly workflow is workflow_dispatch; its external cadence was not established.",
      "sources": [
        "operator-process",
        "processor-logic",
        "rh-installer",
        "rh-nightly"
      ],
      "questions": [
        "Q4",
        "Q6"
      ]
    },
    {
      "id": "rh-bundle",
      "x": 815,
      "y": 1555,
      "w": 650,
      "h": 115,
      "title": "G12 · Operator nudge → processed bundle / Helm",
      "lines": [
        "Bot / file / title checks → bundle nudge merge",
        "Process CSV + relatedImages / Helm values, then build",
        "bundle-patch-only push is excluded from direct Tekton build."
      ],
      "kind": "gate",
      "detail": "RHOAI Build Config bundle-insta-merge validates bot and changed-file feasibility. Process Operator Bundle handles the input change and commits processed bundle/Helm content. The generated content, not merely a bundle-patch edit, triggers the bundle build. Helm builds are parallel outputs; this diagram follows OLM bundle/catalog to the staged installation endpoint.",
      "sources": [
        "rh-bundle-nudge",
        "rh-bundle-process",
        "rh-bundle-build"
      ],
      "questions": [
        "Q5"
      ]
    },
    {
      "id": "rh-catalog",
      "x": 815,
      "y": 1710,
      "w": 650,
      "h": 110,
      "title": "G13 · Bundle digest → catalog processing → FBC build",
      "lines": [
        "catalog/catalog-patch.yaml nudge; process catalog content",
        "Refresh PCC + select bundle snapshot; build FBC fragment",
        "Policy / integration-test enforcement remains Q5."
      ],
      "kind": "gate",
      "detail": "The bundle build nudges catalog/catalog-patch.yaml. Process FBC Fragment refreshes PCC, selects snapshot bundle images and commits catalog content. The direct FBC push trigger excludes catalog-patch-only changes. The inspected IntegrationTestScenario still names the 2.17 application and cannot establish the live 3.6 EC gate.",
      "sources": [
        "rh-bundle-build",
        "rh-fbc-process",
        "rh-fbc-build",
        "ec-scenario"
      ],
      "questions": [
        "Q5"
      ]
    },
    {
      "id": "rh-stage",
      "x": 815,
      "y": 1860,
      "w": 650,
      "h": 125,
      "title": "G14 · Promote selected FBC to stage ? Q5–Q6",
      "lines": [
        "Push To Stage: workflow_dispatch; select FBC / latest nightly",
        "Validate signed-image presence + catalog/PCC data",
        "QE sign-off, release-policy binding and caller / cadence: OPEN"
      ],
      "kind": "uncertain",
      "detail": "Push To Stage accepts an FBC image (or LATEST_NIGHTLY), checks signed-image presence, validates/regenerates PCC, patches the stage catalog on Build Config main and monitors resulting catalog builds. A signature-presence check is not evidence of a full Enterprise Contract verdict. Required QE sign-off and the external trigger are not established.",
      "sources": [
        "stage",
        "ec-scenario"
      ],
      "questions": [
        "Q5",
        "Q6"
      ]
    },
    {
      "id": "stage-output",
      "x": 815,
      "y": 2025,
      "w": 650,
      "h": 82,
      "title": "QE-installable staged catalog",
      "lines": [
        "Built stage catalog → OLM bundle → installer / module / workloads"
      ],
      "kind": "output",
      "detail": "Endpoint requested by the user. Record the catalog digest, bundle digest, installer digest and related component digests together to trace which upstream commit is actually installable. Successful workflows alone do not prove the cluster installs the intended image set.",
      "sources": [
        "stage",
        "rh-bundle-build",
        "rh-installer"
      ],
      "questions": [
        "Q6"
      ]
    }
