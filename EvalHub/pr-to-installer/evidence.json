    {
      "id": "eval-gate",
      "x": 55,
      "y": 240,
      "w": 650,
      "h": 112,
      "title": "G1 · Required upstream merge gate",
      "lines": [
        "1 approval + CODEOWNERS + latest-push approval",
        "Required checks + resolved review threads; up-to-date branch"
      ],
      "kind": "gate",
      "detail": "Effective main rules require quality-checks, Gosec Security Scanner, gosec, dependency-review, CodeQL, docker-build-check; one review, code-owner review, last-push approval, stale-review dismissal and resolved threads. These are observed rules, not an audit of bypass actors. CI quality-checks runs formatting/vet, builds/tests including FVT, and documentation verification.",
      "sources": [
        "eval-rules",
        "eval-ci"
      ],
      "questions": []
    },
    {
      "id": "operator-gate",
      "x": 815,
      "y": 240,
      "w": 650,
      "h": 112,
      "title": "G2 · Upstream CI / merge policy ? Q2",
      "lines": [
        "Controller + module smoke / manifest checks; Prow",
        "Which checks and approvals are enforced remains open."
      ],
      "kind": "uncertain",
      "detail": "GitHub workflows configure controller and module tests. Prow always runs images, and e2e runs for matching paths or an explicit test command. The enforcement layer was not established; do not infer that every listed workflow blocks merging.",
      "sources": [
        "operator-ci",
        "module-ci",
        "prow"
      ],
      "questions": [
        "Q2"
      ]
    },
    {
      "id": "eval-fork",
      "x": 55,
      "y": 390,
      "w": 650,
      "h": 108,
      "title": "G3 · Sync PR → ODH main",
      "lines": [
        "opendatahub-io/eval-hub",
        "Hourly at :23 UTC / manual; conflicts fail; PR merge required"
      ],
      "kind": "gate",
      "detail": "The hourly sync workflow uses a merge strategy, opens/updates a sync PR and fails on conflict. Effective main rules observed via GitHub require one approval. There is no workflow evidence that opening the sync PR automatically advances stable. Upstream CI also publishes quay.io/evalhub/evalhub independently.",
      "sources": [
        "eval-sync",
        "eval-ci"
      ],
      "questions": []
    },
    {
      "id": "operator-fork",
      "x": 815,
      "y": 390,
      "w": 650,
      "h": 108,
      "title": "G4 · Upstream sync PR → ODH main",
      "lines": [
        "opendatahub-io/trustyai-service-operator",
        "Pull bot PR: auto-approve / enable auto-merge; cadence ?"
      ],
      "kind": "gate",
      "detail": "The workflow recognizes pull[bot], approves the sync PR and enables merge-commit auto-merge. This confirms the PR handling, but not the Pull app source configuration or sync schedule. Effective ODH main rules include one approval and CODEOWNERS/latest-push approval.",
      "sources": [
        "operator-sync"
      ],
      "questions": [
        "Q1",
        "Q2"
