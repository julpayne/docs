      "id": "rh-sync",
      "x": 815,
      "y": 750,
      "w": 650,
      "h": 134,
      "title": "G7 · ODH → Red Hat source promotion ? Q1",
      "lines": [
        "red-hat-data-services/{eval-hub, trustyai-service-operator}",
        "Destination builds verified on rhoai-3.6",
        "Source branch / sync bot / cadence / approvals: OPEN"
      ],
      "kind": "uncertain",
      "detail": "The destination release PipelineRuns are verified. The ODH → Red Hat component synchronization mechanism and intermediate branch sequence have not been established. Do not treat this edge as an automatic promotion of ODH images: Red Hat performs a separate build from downstream source.",
      "sources": [
        "rh-eval-build",
        "rh-workload-build"
