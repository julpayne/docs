    {
      "id": "odh-installer",
      "x": 55,
      "y": 1075,
      "w": 650,
      "h": 108,
      "title": "ODH installer operator build",
      "lines": [
        "opendatahub-io/opendatahub-operator main push",
        "Output: opendatahub-operator:odh-stable; path filters apply"
      ],
      "kind": "build",
      "detail": "The checked-in CI push pipeline builds Dockerfiles/rhoai.Dockerfile with BUILD_TYPE=CI via multi-arch-operator-build.yaml and nudges bundle/bundle-patch.yaml. A component image existing in Quay does not itself update this source build.",
      "sources": [
        "odh-installer",
        "manifest-pins"
      ],
      "questions": []
    },
    {
      "id": "rh-images",
      "x": 815,
      "y": 1075,
      "w": 650,
      "h": 132,
      "title": "RHOAI component image builds",
      "lines": [
        "Release-branch push → Konflux hermetic builds",
        "EvalHub + workload + module → quay.io/rhoai/*-rhel9",
        "Four architectures; scans / attestations policy ? Q5"
      ],
      "kind": "build",
      "detail": "Verified release PipelineRuns build source/images from downstream Dockerfile.konflux definitions for x86_64, ppc64le, s390x and arm64. Each inspected component push pipeline sets build-nudge-files to build/operator-nudging.yaml. Image publication and policy approval are separate states.",
      "sources": [
        "rh-eval-build",
        "rh-workload-build",
        "rh-module-build",
        "rh-central"
      ],
      "questions": [
        "Q5"
      ]
